{
  "PreToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        { "type": "command", "command": "python3 ~/.claude/hooks/subagent_fanout_guard.py" }
      ]
    }
  ],
  "SubagentStart": [
    {
      "hooks": [
        { "type": "command", "command": "python3 ~/.claude/hooks/subagent_fanout_guard.py" }
      ]
    }
  ],
  "SubagentStop": [
    {
      "hooks": [
        { "type": "command", "command": "python3 ~/.claude/hooks/subagent_fanout_guard.py" }
      ]
    }
  ]
}
